{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "File": {
      "Path": "logs/api-.log",
      "RetainedFileCountLimit": 31,
      "FileSizeLimitBytes": 10485760
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "transfers-dashboard",
    "Audience": "transfers-dashboard-ui",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshCookieName": "tfx_refresh"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SeedData": {
    "DemoPassword": ""
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    },
    "Mutations": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    }
  },
  "SimulatedBroker": {
    "DelayMilliseconds": 1500
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:29092",
    "CommandsTopic": "transfers-commands",
    "GroupId": "transfers-dashboard",
    "ClientId": "transfers-dashboard",
    "DlqTopic": "transfers-events-dlq",
    "Topics": {
      "TransactionInitiatedEvent": "transaction.initiated",
      "TransactionPausedEvent": "transaction.paused",
      "TransactionUnpausedEvent": "transaction.unpaused",
      "TransactionUnpauseRequestedEvent": "transaction.unpause_requested",
      "TransactionCreditCompletedEvent": "transaction.credit_completed",
      "TransactionCreditFailedEvent": "transaction.credit_failed",
      "TransactionCreditFailedRetryEvent": "transaction.credit_failed_retry",
      "TransactionCreditRetryRequestedEvent": "transaction.credit_retry_requested",
      "TransactionRegistrationCompletedEvent": "transaction.registration_completed",
      "TransactionRegistrationFailedRetryEvent": "transaction.registration_failed_retry",
      "TransactionRegistrationRetryRequestedEvent": "transaction.registration_retry_requested"
    }
  },
  "MassTransit": {
    "Enabled": false,
    "BootstrapServers": "localhost:29092",
    "GroupId": "transfers-dashboard",
    "SecurityProtocol": "",
    "SaslMechanism": "",
    "SaslUsername": "",
    "SaslPassword": "",
    "SslCaLocation": "",
    "EnableSslCertificateVerification": false,
    "PrefetchCount": 10,
    "ConcurrentMessageLimit": 5,
    "Retry": {
      "Limit": 5,
      "MinIntervalSeconds": 5,
      "MaxIntervalSeconds": 60,
      "IntervalDeltaSeconds": 5
    }
  }
}
